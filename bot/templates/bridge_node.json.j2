{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": ["geosite:geolocation-!cn"]
      },
      "8.8.8.8",
      "localhost"
    ]
  },
  "inbounds": [
    {
      "tag": "inbound-client",
      "protocol": "vless",
      "listen": "0.0.0.0",
      "port": 443,
      "settings": {
        "clients": [
          {% for c in clients %}
          {"id": "{{ c.uuid }}", "flow": "xtls-rprx-vision", "email": "{{ c.uuid }}"}{% if not loop.last %},{% endif %}
          {% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ bridge_reality_dest }}",
          "xver": 0,
          "serverNames": ["{{ bridge_reality_sni }}"],
          "privateKey": "{{ bridge_x25519_private }}",
          "shortIds": [{% for sid in bridge_short_ids %}"{{ sid }}"{% if not loop.last %}, {% endif %}{% endfor %}]
        },
        "tcpSettings": {
          "header": {
            "type": "none"
          }
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "fakedns", "quic"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy-exit",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{ exit_node_ip }}",
            "port": 443,
            "users": [
              {
                "id": "{{ bridge_uuid }}",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "{{ reality_sni }}",
          "fingerprint": "{{ fingerprint }}",
          "publicKey": "{{ x25519_public }}",
          "shortId": "{{ short_id }}"
        },
        "tcpSettings": {
          "header": {
            "type": "none"
          }
        }
      }
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "ip": ["geoip:private", "geoip:ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": ["geosite:category-ru"],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "inboundTag": ["inbound-client"],
        "outboundTag": "proxy-exit"
      }
    ]
  }
}
