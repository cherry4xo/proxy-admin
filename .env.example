# Telegram Bot
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_IDS=[123456789]

DATABASE_URL=sqlite+aiosqlite:///./proxy.db
# Encryption key for SSH private keys and X25519 keys stored in DB                                                                                                                            
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=                                                                                                                                                                                 
BITLAUNCH_API_TOKEN=your_bitlaunch_api_token_here
BITLAUNCH_HOST_ID=4                                                                                                                                                                             
YANDEX_FOLDER_ID=b1gxxxxxxxxxxxxxxxxx
# IAM token: получить через `yc iam create-token`
YANDEX_IAM_TOKEN=t1.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Subnet ID для создания ВМ (из YC консоли -> VPC -> Подсети)
YANDEX_SUBNET_ID=e9bxxxxxxxxxxxxxxxxx                                                                                                                                                         
# Availability zone
YANDEX_ZONE_ID=ru-central1-a
# Image ID для Ubuntu 22.04 LTS в YC (из YC консоли -> Compute -> Образы)
YANDEX_IMAGE_ID=fd8xxxxxxxxxxxxxxxxx
# Xray defaults                                                                                                                                                                               
REALITY_SNI=www.microsoft.com          
XRAY_API_PORT=8080