{
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": ["geosite:geolocation-!cn"]
      },
      "8.8.8.8",
      "localhost"
    ]
  },
  "inbounds": [
    {
      "tag": "inbound-vless",
      "protocol": "vless",
      "port": 443,
      "settings": {
        "clients": [
          {% for c in clients %}
          {"id": "{{ c.uuid }}", "flow": "xtls-rprx-vision", "email": "{{ c.uuid }}"}{% if not loop.last %},{% endif %}
          {% endfor %}
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "{{ reality_sni }}:443",
          "xver": 0,
          "serverNames": ["{{ reality_sni }}"],
          "privateKey": "{{ x25519_private }}",
          "shortIds": [{% for sid in short_ids %}"{{ sid }}"{% if not loop.last %}, {% endif %}{% endfor %}]
        },
        "tcpSettings": {
          "header": {
            "type": "none"
          }
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "fakedns", "quic"],
        "routeOnly": true
      }
    },
    {
      "tag": "api",
      "listen": "127.0.0.1",
      "port": {{ xray_api_port }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "streamSettings": {
        "network": "tcp"
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
{% if warp_enabled %}
    {
      "protocol": "wireguard",
      "tag": "warp",
      "settings": {
        "secretKey": "{{ warp_secret_key }}",
        "address": [{% for a in warp_address %}"{{ a }}"{% if not loop.last %}, {% endif %}{% endfor %}],
        "peers": [
          {
            "publicKey": "bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=",
            "allowedIPs": ["0.0.0.0/0", "::/0"],
            "endpoint": "engage.cloudflareclient.com:2408"
          }
        ],
        "reserved": [{{ warp_reserved }}],
        "mtu": 1280
      }
    },
{% endif %}
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "api": {
    "tag": "api",
    "services": ["HandlerService", "StatsService", "LoggerService"]
  },
  "stats": {},
  "policy": {
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
{% if warp_enabled %}
  "observatory": {
    "subjectSelector": ["warp", "direct"],
    "probeUrl": "https://www.gstatic.com/generate_204",
    "probeInterval": "30s"
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "balancers": [
      {
        "tag": "out",
        "selector": ["warp", "direct"],
        "strategy": {"type": "leastPing"}
      }
    ],
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "out"
      }
    ]
  }
{% else %}
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      }
    ]
  }
{% endif %}
}
